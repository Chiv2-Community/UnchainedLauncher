<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <InternalsVisibleTo Include="UnchainedLauncher.CLI.Tests" />
    <ProjectReference Include="..\UnchainedLauncher.Core\UnchainedLauncher.Core.csproj" />
  </ItemGroup>
  <Target Name="PublishProtonHelper" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)/../UnchainedLauncher.ProtonHelper/UnchainedLauncher.ProtonHelper.csproj&quot; -c $(Configuration) -r win-x64 --self-contained true -o &quot;$(PublishDir)proton-helper&quot;" />
  </Target>
</Project>
