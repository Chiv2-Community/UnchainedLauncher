<UserControl x:Class="UnchainedLauncher.GUI.Views.Help"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:UnchainedLauncher.GUI.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Vertical" Margin="0,0,10,0">
            <controls:CollapsibleCard Header="Updates &amp; Maintenance" Margin="0,0,0,10" IsExpanded="True">
                <controls:CollapsibleCard.Body>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Keep your launcher and game files up to date and clean." 
                                   Margin="0,0,0,10" TextWrapping="Wrap" Opacity="0.7"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Check for Updates" 
                                    Command="{Binding SettingsViewModel.CheckForUpdateCommand}" 
                                    Style="{DynamicResource Button.Primary}" 
                                    Padding="20,8" Margin="0,0,10,0" />
                            <Button Content="Clean Up Installation" 
                                    Command="{Binding SettingsViewModel.CleanUpInstallationCommand}" 
                                    Style="{DynamicResource Button.Secondary}" 
                                    Padding="20,8" Margin="0,0,10,0" />
                            <Button Content="Uninstall" 
                                    Command="{Binding SettingsViewModel.UninstallLauncherCommand}" 
                                    Style="{DynamicResource Button.Danger}" 
                                    Padding="20,8" />
                        </StackPanel>
                    </StackPanel>
                </controls:CollapsibleCard.Body>
            </controls:CollapsibleCard>

            <controls:CollapsibleCard Header="Community &amp; Documentation" Margin="0,0,0,10" IsExpanded="True">
                <controls:CollapsibleCard.Body>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Join our community and read the documentation for help and more information." 
                                   Margin="0,0,0,10" TextWrapping="Wrap" Opacity="0.7"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Discord" 
                                    Command="{Binding OpenDiscordCommand}" 
                                    Style="{DynamicResource Button.Secondary}" 
                                    Padding="20,8" Margin="0,0,10,0" />
                            <Button Content="Unchained Wiki" 
                                    Command="{Binding OpenWikiCommand}" 
                                    Style="{DynamicResource Button.Secondary}" 
                                    Padding="20,8" />
                        </StackPanel>
                    </StackPanel>
                </controls:CollapsibleCard.Body>
            </controls:CollapsibleCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
