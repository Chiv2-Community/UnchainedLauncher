<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Windows exercises the real control; WpfTests also permits Linux cross-compilation. -->
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows')) Or '$(WpfTests)' == 'true'">net10.0-windows</TargetFramework>
    <UseWPF Condition="'$(TargetFramework)' == 'net10.0-windows'">true</UseWPF>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <Page Include="../UnchainedLauncher.GUI/Views/Controls/CollapsibleCard.xaml" Link="Controls/CollapsibleCard.xaml" />
    <Compile Include="../UnchainedLauncher.GUI/Views/Controls/CollapsibleCard.xaml.cs" Link="Controls/CollapsibleCard.xaml.cs" />
    <Compile Include="../UnchainedLauncher.GUI/Views/Controls/InputOptions.cs" Link="Controls/InputOptions.cs" />
    <Compile Include="../UnchainedLauncher.GUI/Behaviors/SearchableComboBoxBehavior.cs" Link="SearchableComboBoxBehavior.cs" />
    <Compile Include="../UnchainedLauncher.GUI/Behaviors/MouseWheelScrollForwardingBehavior.cs" Link="MouseWheelScrollForwardingBehavior.cs" />
    <Compile Include="../UnchainedLauncher.GUI/Converters/RoundedRectClipConverter.cs" Link="RoundedRectClipConverter.cs" />
    <Compile Include="../UnchainedLauncher.GUI/Converters/ModSortModeToStringConverter.cs" Link="ModSortModeToStringConverter.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-windows'">
    <Compile Remove="CardVisualTreeTests.cs" />
    <Compile Remove="ProgressVisualTests.cs" />
    <Compile Remove="SearchableComboBoxTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../UnchainedLauncher.GUI/Views/Controls/CollapsibleCard.xaml" Link="Views/CollapsibleCard.xaml" CopyToOutputDirectory="PreserveNewest" />
    <!-- Exercise the platform-independent view model without loading WPF. -->
    <Compile Include="../UnchainedLauncher.GUI/ViewModels/DllManagerVM.cs" Link="DllManagerVM.cs" />
    <Compile Include="../UnchainedLauncher.GUI/Services/SavedPaksPreparer.cs" Link="SavedPaksPreparer.cs" />
    <Compile Include="../UnchainedLauncher.GUI/ViewModels/Registry/RegistryReleaseFormVM.cs" Link="RegistryReleaseFormVM.cs" />
    <Compile Include="../UnchainedLauncher.GUI/ViewModels/ModSortMode.cs" Link="ModSortMode.cs" />
    <Compile Include="../UnchainedLauncher.GUI/ViewModels/ModVM.cs" Link="ModVM.cs" />
    <Compile Include="../UnchainedLauncher.GUI/ViewModels/ModListVM.cs" Link="ModListVM.cs" />
    <Compile Include="../UnchainedLauncher.GUI/JsonModels/LauncherSettings.cs" Link="LauncherSettings.cs" />
    <None Include="../UnchainedLauncher.GUI/Views/Mods/Mod.xaml" Link="Views/Mod.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../UnchainedLauncher.GUI/Views/Mods/ModList.xaml" Link="Views/ModList.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../UnchainedLauncher.GUI/Views/MainWindow.xaml" Link="Views/MainWindow.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../UnchainedLauncher.GUI/Resources/Themes/Misc.xaml" Link="Views/Misc.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../UnchainedLauncher.GUI/Resources/Themes/Buttons.xaml" Link="Views/Buttons.xaml" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../UnchainedLauncher.GUI/Services/FuzzySearch.cs" Link="FuzzySearch.cs" />
    <None Include="../UnchainedLauncher.GUI/Resources/Themes/Inputs.xaml" Link="Views/Inputs.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../UnchainedLauncher.GUI/Resources/Themes/DarkConstants.xaml" Link="Views/DarkConstants.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../UnchainedLauncher.GUI/Resources/Themes/LightConstants.xaml" Link="Views/LightConstants.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../UnchainedLauncher.GUI/Views/Installer/VersionSelectionView.xaml" Link="Views/VersionSelectionView.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../UnchainedLauncher.GUI/Views/Installer/InstallationTargetView.xaml" Link="Views/InstallationTargetView.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../UnchainedLauncher.GUI/Views/Servers/Sections/BaseConfigurationSectionView.xaml" Link="Views/BaseConfigurationSectionView.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../UnchainedLauncher.GUI/Views/Servers/Server.xaml" Link="Views/Server.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../UnchainedLauncher.GUI/Views/Servers/ServersTab.xaml" Link="Views/ServersTab.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../UnchainedLauncher.GUI/Views/Settings.xaml" Link="Views/Settings.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../UnchainedLauncher.GUI/Views/Progress/MemoryProgressDisplay.xaml" Link="Views/MemoryProgressDisplay.xaml" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../UnchainedLauncher.Core/UnchainedLauncher.Core.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="PropertyChanged.Fody" Version="4.1.0" PrivateAssets="All" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.1.0" />
    <PackageReference Include="xunit" Version="2.4.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.3" />
  </ItemGroup>
</Project>
