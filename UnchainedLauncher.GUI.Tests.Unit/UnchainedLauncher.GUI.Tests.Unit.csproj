<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Windows exercises the real control; WpfTests also permits Linux cross-compilation. -->
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows')) Or '$(WpfTests)' == 'true'">net10.0-windows</TargetFramework>
    <UseWPF Condition="'$(TargetFramework)' == 'net10.0-windows'">true</UseWPF>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <Page Include="../UnchainedLauncher.GUI/Views/Controls/CollapsibleCard.xaml" Link="Controls/CollapsibleCard.xaml" />
    <Compile Include="../UnchainedLauncher.GUI/Views/Controls/CollapsibleCard.xaml.cs" Link="Controls/CollapsibleCard.xaml.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-windows'">
    <Compile Remove="CardVisualTreeTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../UnchainedLauncher.GUI/Views/Controls/CollapsibleCard.xaml" Link="Views/CollapsibleCard.xaml" CopyToOutputDirectory="PreserveNewest" />
    <!-- Exercise the platform-independent view model without loading WPF. -->
    <Compile Include="../UnchainedLauncher.GUI/ViewModels/DllManagerVM.cs" Link="DllManagerVM.cs" />
    <Compile Include="../UnchainedLauncher.GUI/ViewModels/Registry/RegistryReleaseFormVM.cs" Link="RegistryReleaseFormVM.cs" />
    <Compile Include="../UnchainedLauncher.GUI/ViewModels/ModSortMode.cs" Link="ModSortMode.cs" />
    <Compile Include="../UnchainedLauncher.GUI/JsonModels/LauncherSettings.cs" Link="LauncherSettings.cs" />
    <None Include="../UnchainedLauncher.GUI/Views/Mods/Mod.xaml" Link="Views/Mod.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../UnchainedLauncher.GUI/Views/MainWindow.xaml" Link="Views/MainWindow.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../UnchainedLauncher.GUI/Resources/Themes/Misc.xaml" Link="Views/Misc.xaml" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../UnchainedLauncher.Core/UnchainedLauncher.Core.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="PropertyChanged.Fody" Version="4.1.0" PrivateAssets="All" ExcludeAssets="build;buildTransitive" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.1.0" />
    <PackageReference Include="xunit" Version="2.4.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.3" />
  </ItemGroup>
</Project>
