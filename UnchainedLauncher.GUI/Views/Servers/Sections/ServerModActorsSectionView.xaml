<UserControl x:Class="UnchainedLauncher.GUI.Views.Servers.Sections.ServerModActorsSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:UnchainedLauncher.GUI.Converters"
             xmlns:designInstances="clr-namespace:UnchainedLauncher.GUI.Views.Servers.DesignInstances"
             xmlns:controls="clr-namespace:UnchainedLauncher.GUI.Views.Controls"
             xmlns:behaviors="clr-namespace:UnchainedLauncher.GUI.Behaviors"
             d:DataContext="{d:DesignInstance designInstances:ServerConfigurationDesignVM}"
             Background="{DynamicResource Brush.Background}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <conv:ReleaseEnabledConverter x:Key="ReleaseEnabledConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <DataTemplate x:Key="LocalModActorsHeader">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Server Mod Actors" VerticalAlignment="Center" />
                <Button x:Name="ScanLocalModsButton" Grid.Column="1" Content="Scan local mods"
                        Margin="12,0,0,0" Padding="8,3" FontSize="12"
                        FontWeight="Normal" VerticalAlignment="Center"
                        Visibility="{Binding LocalModScan.HasUnmanagedPaks, Converter={StaticResource BoolToVisibility}}"
                        IsEnabled="{Binding LocalModScan.CanScan}" Click="ScanLocalMods_OnClick" />
                <ProgressBar Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                             Height="{Binding ActualHeight, ElementName=ScanLocalModsButton}"
                             Minimum="0" Maximum="100" Value="{Binding LocalModScan.Scanner.ScanProgress}"
                             Visibility="{Binding LocalModScan.Scanner.IsScanning, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center"
                           FontWeight="Normal" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}"
                           Text="{Binding LocalModScan.LocalModActorCount, StringFormat={}{0} Local Mod Actors Detected}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <controls:CollapsibleCard
        Header="{Binding}"
        HeaderTemplate="{StaticResource LocalModActorsHeader}"
        IsExpanded="True">
        <ListBox ItemsSource="{Binding AvailableServerModBlueprints}" 
                 BorderThickness="0"
                 behaviors:MouseWheelScrollForwardingBehavior.IsEnabled="True">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <CheckBox
                            VerticalAlignment="Center"
                            Checked="CheckBox_OnChecked"
                            Unchecked="CheckBox_OnUnchecked">
                            <CheckBox.IsChecked>
                                <MultiBinding Converter="{StaticResource ReleaseEnabledConverter}" Mode="OneWay">
                                    <Binding />
                                    <Binding RelativeSource="{RelativeSource AncestorType=UserControl}" Path="DataContext.EnabledServerModList" />
                                    <!-- Bind to Count to force re-evaluation when collection changes -->
                                    <Binding RelativeSource="{RelativeSource AncestorType=UserControl}" Path="DataContext.EnabledServerModList.Count" />
                                </MultiBinding>
                            </CheckBox.IsChecked>
                        </CheckBox>
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center">
                            <Run Text="{Binding ModName}" />
                            <Run Text="  (" />
                            <Run Text="{Binding Version}" />
                            <Run Text=")" />
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </controls:CollapsibleCard>
</UserControl>
