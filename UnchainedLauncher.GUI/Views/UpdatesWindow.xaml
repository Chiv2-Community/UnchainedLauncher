<views:UnchainedWindow x:Class="UnchainedLauncher.GUI.Views.UpdatesWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:views="clr-namespace:UnchainedLauncher.GUI.Views"
                       Title="{Binding TitleText}"
                       Width="640" Height="600" MinWidth="400" MinHeight="280"
                       Loaded="SizeForCards"
                       ResizeMode="CanResizeWithGrip"
                       WindowStartupLocation="CenterOwner"
                       FocusManager.FocusedElement="{Binding ElementName=Yes}"
                       Style="{DynamicResource UnchainedChrome}">
    <views:UnchainedWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
    </views:UnchainedWindow.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="{Binding TitleText}" Style="{DynamicResource Heading.H2}" />
            <TextBlock Text="{Binding MessageText}" Margin="0,8,0,0"
                       Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer x:Name="CardsViewport" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="Cards" ItemsSource="{Binding Updates}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Brush.Light}" BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,8,8" MinHeight="104">
                            <StackPanel>
                                <TextBlock Text="{Binding Update.Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Update.Reason}" Margin="0,4,0,8"
                                           Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" />
                                <WrapPanel>
                                    <TextBlock Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,12,0">
                                        <Run Text="Version: " /><Run Text="{Binding VersionString, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Visibility="{Binding HasReleaseInformation, Converter={StaticResource BooleanVisibility}}">
                                        <Hyperlink NavigateUri="{Binding Update.ReleaseUrl}" Command="{Binding HyperlinkCommand}"
                                                   Foreground="{DynamicResource Brush.Primary}">View release information</Hyperlink>
                                    </TextBlock>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Name="Yes" IsDefault="True" Content="{Binding YesButtonText}" Command="{Binding YesCommand}"
                        MinWidth="96" Height="36" Margin="0,0,8,0" Style="{StaticResource Button.Primary}" />
                <Button Content="{Binding NoButtonText}" Command="{Binding NoCommand}"
                        MinWidth="96" Height="36" Margin="0,0,8,0" Style="{StaticResource Button.Secondary}" />
                <Button Content="{Binding CancelButtonText}" Command="{Binding CancelCommand}" IsCancel="True"
                        Visibility="{Binding ShowCancelButton, Converter={StaticResource BooleanVisibility}}"
                        MinWidth="96" Height="36" Style="{StaticResource Button.Light}" />
            </StackPanel>
        </Border>
    </Grid>
</views:UnchainedWindow>
